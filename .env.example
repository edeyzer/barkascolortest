# ===============================
# 🤖 Telegram bot konfiguratsiyasi
# ===============================
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id

# ===============================
# 🗄️ Ma'lumotlar bazasi sozlamalari
# ===============================
DB_TYPE=sqlite  # sqlite yoki postgresql

# SQLite
DB_PATH=bot.db

# PostgreSQL (agar kerak bo‘lsa)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=colorbotdb

# ===============================
# ⚙️ Muhit va loglar
# ===============================
ENV=development
LOG_LEVEL=INFO
AUTO_SUGGEST=True